# ==========================================
# Root Git Ignore - Meowtopia Super App
# ==========================================

# OS generated files
.DS_Store
Thumbs.db
*.swp
*~

# IDE and Editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local development tools
.tools/

# Local project references
/docs/

# ------------------------------------------
# Backend (Laravel)
# ------------------------------------------
backend/vendor/
backend/node_modules/
backend/public/storage
backend/public/hot
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/Homestead.json
backend/Homestead.yaml
backend/npm-debug.log
backend/yarn-error.log

# ------------------------------------------
# Frontend (Flutter)
# ------------------------------------------
frontend/.dart_tool/
frontend/.widget_preview/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/ios/Flutter/.last_build_id
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/gradle-app.setting
frontend/android/captures/
frontend/android/app/build/
frontend/*.iml
frontend/android/*.iml
frontend/ios/*.iml
